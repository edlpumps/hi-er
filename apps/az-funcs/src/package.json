{
  "name": "durable-functions-quickstart-typescript-azd",
  "version": "1.0.0",
  "description": "Azure Durable Functions TypeScript quickstart demonstrating the fan-out/fan-in pattern",
  "main": "dist/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prestart": "npm run build",
    "start": "func start",
    "azurite": "azurite --skipApiVersionCheck --location ../azurite-data"
  },
  "keywords": [
    "azure",
    "functions",
    "durable",
    "typescript"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.x",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.31.0",
    "@marplex/hono-azurefunc-adapter": "^1.0.1",
    "@types/uuid": "^10.0.0",
    "archiver": "^7.0.1",
    "chanfana": "^3.2.1",
    "dotenv": "^17.3.1",
    "durable-functions": "^3.0.0",
    "hono": "^4.12.8",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
